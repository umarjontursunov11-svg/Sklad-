# Supabase Configuration
# Replace these with your actual Supabase Project settings found in:
# Project Settings -> API -> Project URL & Project API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Secret key (sb_secret_...), NEVER the publishable/anon key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Next.js App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram Bot Reporting & Alerts Configuration
# 1. Create a bot using @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# 2. Add your bot to the warehouse management Telegram group and get the chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CHAT_ID=-1001234567890

# Secret used by Vercel Cron to call /api/telegram/send-report (generate a long random string)
CRON_SECRET=replace-with-long-random-string
